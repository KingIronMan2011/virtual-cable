{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual Cable",
  "version": "0.1.0",
  "identifier": "com.virtualcable.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Virtual Cable",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQTBFRjRFMjk0MkI5Q0IKUldUTHVVSXBUdStnVGx3YS9vL1pBSnBBWjU1Q3hZdEpzcU9FbytrOGlDWFRCa1BUakdXRHVpelYK",
      "endpoints": ["https://virtual-cable.kingironman.dev/updates.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
